pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../credentials-same-holder/src/same-holder";
include "../../credentials-iso-registry/src/iso-registry";
include "../../credentials-passport/src/passport-credential/claims";
include "./secret-passport-credential/model";

import VC<PassportCredentialClaims, SecretPassportCredentialDisclosures, BlindedSecretHolderBinding>;

export type SecretPassportCredential = Credential;
export type SecretPassportCredentialPresentation = Presentation;
include "./secret-passport-credential/protocol-model";

import IssuanceProtocol<
  SecretPassportCredentialIssuanceOfferBody,
  SecretPassportCredentialIssuanceRequestBody,
  SecretPassportCredentialIssuanceResultBody
> prefix SecretPassportCredentialIssuance_;

import PresentationProtocol<
  SecretPassportCredentialVerificationRequestBody,
  SecretPassportCredentialVerificationSubmissionBody,
  SecretPassportCredentialVerificationResultBody
> prefix SecretPassportCredentialVerification_;

export type SecretPassportCredentialIssuanceOffer = SecretPassportCredentialIssuance_OfferMessage;
export type SecretPassportCredentialIssuanceRequest = SecretPassportCredentialIssuance_RequestMessage;
export type SecretPassportCredentialIssuanceResult = SecretPassportCredentialIssuance_ResultMessage;
export type SecretPassportCredentialVerificationRequest = SecretPassportCredentialVerification_RequestMessage;
export type SecretPassportCredentialVerificationSubmission = SecretPassportCredentialVerification_SubmissionMessage;
export type SecretPassportCredentialVerificationResult = SecretPassportCredentialVerification_ResultMessage;
include "./secret-passport-credential/helpers";
include "./secret-passport-credential/validation";
