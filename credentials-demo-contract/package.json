{
  "name": "@midnight-ntwrk/midnight-did-credentials-demo-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "contract": "npm run compact",
    "compact": "compact compile src/demo.compact src/managed/demo && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "test": "vitest run --exclude src/test/integration/**/*.test.ts",
    "test:integration": "vitest run --dir src/test/integration",
    "test:ci": "vitest run --exclude src/test/integration/**/*.test.ts",
    "prepack": "npm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "npm run compact && rm -rf dist && tsc -b tsconfig.build.json --force && mkdir -p dist && cp -Rf ./src/managed ./dist/ && cp ./src/demo.compact ./dist",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "npm run compact && tsc -p tsconfig.json --noEmit",
    "all": "npm run compact && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "*",
    "@midnight-ntwrk/midnight-did-credentials": "*",
    "@midnight-ntwrk/midnight-did-credentials-birth": "*",
    "@midnight-ntwrk/midnight-did-standalone-environment": "*"
  }
}
