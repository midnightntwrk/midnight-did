{
  "name": "midnight-did",
  "version": "0.1.0",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "npm run clean -w contract && npm run clean -w domain && npm run clean -w did && npm run clean -w api && npm run clean -w secret-storage && npm run clean -w did-resolver-service && npm run clean -w did-manager-service",
    "lint": "npm run lint -w contract && npm run lint -w domain && npm run lint -w did && npm run lint -w api && npm run lint -w secret-storage && npm run lint -w did-resolver-service && npm run lint -w did-manager-service",
    "lint:fix": "npm run lint:fix -w contract && npm run lint:fix -w domain && npm run lint:fix -w did && npm run lint:fix -w api && npm run lint:fix -w secret-storage && npm run lint:fix -w did-resolver-service && npm run lint:fix -w did-manager-service",
    "build:all": "npm run build -w contract && npm run build -w secret-storage",
    "test:all": "npm run all -w contract && npm run test -w api",
    "coverage": "npm run coverage -w contract",
    "ci": "npm run contract -w contract && npm run build -w contract && npm run all -w contract && npm run build -w secret-storage && npm run test -w api",
    "pack:contract": "npm_config_cache=.npm-cache bash -lc 'cd contract && npm pack'",
    "pack:all": "npm run pack:contract && echo 'Artifacts:' && ls -1 *.tgz || true && ls -1 contract/*.tgz || true",
    "checkdeps": "bash scripts/check-deps.sh",
    "docs:sync-source": "npm run docs:sync-source -w docs-site",
    "docs:api": "npm run docs:api -w docs-site",
    "docs:dev": "npm run docs:dev -w docs-site",
    "docs:build": "npm run docs:build -w docs-site",
    "docs:preview": "npm run docs:preview -w docs-site"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "api",
    "domain",
    "did",
    "contract",
    "standalone-environment",
    "secret-storage",
    "did-resolver-service",
    "did-manager-service",
    "docs-site"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "testcontainers": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "^4.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-types": "^4.0.0",
    "@midnight-ntwrk/midnight-js-utils": "^4.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "^2.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^2.0.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.2",
    "zod": "^4.1.0",
    "@midnight-ntwrk/ledger-v8": "^8.0.0"
  },
  "eslintConfig": {
    "plugins": [
      "import",
      "simple-import-sort"
    ],
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "ignoreRestSiblings": true
        }
      ],
      "import/no-unused-modules": [
        1,
        {
          "unusedExports": true
        }
      ],
      "no-duplicate-imports": "error",
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error"
    }
  }
}
