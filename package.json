{
  "name": "midnight-did",
  "version": "0.1.0",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "turbo run clean --filter=./jubjub-schnorr --filter=./contract --filter=./domain --filter=./did --filter=./api --filter=./secret-storage --filter=./did-resolver-service --filter=./did-manager-service --continue",
    "lint": "turbo run lint --filter=./jubjub-schnorr --filter=./contract --filter=./domain --filter=./did --filter=./api --filter=./secret-storage --filter=./did-resolver-service --filter=./did-manager-service --continue",
    "lint:fix": "turbo run lint:fix --filter=./jubjub-schnorr --filter=./contract --filter=./domain --filter=./did --filter=./api --filter=./secret-storage --filter=./did-resolver-service --filter=./did-manager-service --continue",
    "lint:core": "turbo run lint --filter=./jubjub-schnorr --filter=./contract --filter=./domain --filter=./did --filter=./secret-storage --continue",
    "build:all": "npm run build -w jubjub-schnorr && turbo run build --filter=./contract --filter=./secret-storage --continue",
    "typecheck:all": "turbo run typecheck --filter=./jubjub-schnorr --filter=./contract --filter=./domain --filter=./did --filter=./api --filter=./secret-storage --filter=./did-resolver-service --filter=./did-manager-service --continue",
    "test:all": "turbo run test:ci --filter=./contract --filter=./api --continue",
    "coverage": "npm run coverage -w contract",
    "ci": "npm run lint && npm run build:all && npm run test:all",
    "ci:core": "SKIP_LINT_FIX=1 npm run lint:core && npm run build -w jubjub-schnorr && npm run test:ci -w jubjub-schnorr && npm run build -w contract && SKIP_RUNTIME_TESTS=1 npm run test:ci -w contract && npm run build -w domain && npm run test:ci -w domain && npm run build -w did && npm run test:ci -w did && npm run build -w secret-storage && npm run test:ci -w secret-storage",
    "build:service-prereqs": "npm run build -w contract && turbo run build --filter=./did --filter=./secret-storage --continue && npm run build -w api",
    "build:manager-prereqs": "npm run build:service-prereqs",
    "pack:contract": "npm_config_cache=.npm-cache bash -lc 'cd contract && npm pack'",
    "pack:all": "npm run pack:contract && echo 'Artifacts:' && ls -1 *.tgz || true && ls -1 contract/*.tgz || true",
    "checkdeps": "bash scripts/check-deps.sh",
    "docs:sync-source": "npm run docs:sync-source -w docs-site",
    "docs:api": "npm run docs:api -w docs-site",
    "docs:dev": "npm run docs:dev -w docs-site",
    "docs:build": "npm run docs:build -w docs-site",
    "docs:preview": "npm run docs:preview -w docs-site",
    "artifacts:pack": "./scripts/pack-artifacts.sh"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "api",
    "domain",
    "did",
    "jubjub-schnorr",
    "contract",
    "secret-storage",
    "did-resolver-service",
    "did-manager-service",
    "docs-site"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "testcontainers": "^11.0.0",
    "turbo": "^2.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "^4.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-types": "^4.0.0",
    "@midnight-ntwrk/midnight-js-utils": "^4.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "^2.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^2.0.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.2",
    "zod": "^4.1.0",
    "@midnight-ntwrk/ledger-v8": "^8.0.0"
  },
  "eslintConfig": {
    "plugins": [
      "import",
      "simple-import-sort"
    ],
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "ignoreRestSiblings": true
        }
      ],
      "import/no-unused-modules": [
        1,
        {
          "unusedExports": true
        }
      ],
      "no-duplicate-imports": "error",
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error"
    }
  }
}
