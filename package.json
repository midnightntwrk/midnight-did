{
  "name": "midnight-did",
  "version": "0.1.0",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "turbo run clean --filter=./packages/jubjub-schnorr --filter=./packages/contract --filter=./packages/domain --filter=./packages/did --filter=./packages/api --continue",
    "lint": "turbo run lint --filter=./packages/jubjub-schnorr --filter=./packages/contract --filter=./packages/domain --filter=./packages/did --filter=./packages/api --continue",
    "lint:fix": "turbo run lint:fix --filter=./packages/jubjub-schnorr --filter=./packages/contract --filter=./packages/domain --filter=./packages/did --filter=./packages/api --continue",
    "lint:core": "turbo run lint --filter=./packages/jubjub-schnorr --filter=./packages/contract --filter=./packages/domain --filter=./packages/did --continue",
    "build:all": "npm run build -w ./packages/jubjub-schnorr && npm run build:api-prereqs",
    "typecheck:all": "turbo run typecheck --filter=./packages/jubjub-schnorr --filter=./packages/contract --filter=./packages/domain --filter=./packages/did --filter=./packages/api --continue",
    "test:all": "turbo run test:ci --filter=./packages/contract --filter=./packages/api --continue",
    "coverage": "npm run coverage -w ./packages/contract",
    "ci": "./run.sh --light --strict",
    "ci:packages": "npm run lint && npm run build:all && npm run test:all",
    "ci:core": "npm run test:did-surface-discipline && npm run check:did-surface-discipline && npm run test:workspace-manifests && npm run check:workspace-manifests && npm run test:artifact-workspaces && npm run test:managed-artifacts && npm run test:integration-report && npm run test:source-imports && npm run check:source-imports && npm run check:run-target-catalog && SKIP_LINT_FIX=1 npm run lint:core && npm run build -w ./packages/jubjub-schnorr && npm run test:ci -w ./packages/jubjub-schnorr && npm run build:prepared -w ./packages/contract && SKIP_RUNTIME_TESTS=1 npm run test:ci -w ./packages/contract && npm run check:managed-artifacts && npm run build -w ./packages/domain && npm run test:ci -w ./packages/domain && npm run build -w ./packages/did && npm run test:ci -w ./packages/did",
    "build:api-prereqs": "npm run build:prepared -w ./packages/contract && npm run build -w ./packages/did && npm run build -w ./packages/api",
    "pack:contract": "npm_config_cache=.npm-cache bash -lc 'cd packages/contract && npm pack'",
    "pack:all": "npm run pack:contract && echo 'Artifacts:' && ls -1 *.tgz || true && ls -1 packages/contract/*.tgz || true",
    "checkdeps": "bash scripts/check-deps.sh",
    "docs:sync-source": "npm run docs:sync-source -w docs-site",
    "docs:api": "npm run docs:api -w docs-site",
    "docs:dev": "npm run docs:dev -w docs-site",
    "docs:build": "npm run docs:build -w docs-site",
    "docs:preview": "npm run docs:preview -w docs-site",
    "artifacts:pack": "./scripts/pack-artifacts.sh",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "report:integration": "node scripts/report-integration.mjs",
    "check:integration": "node scripts/report-integration.mjs --check",
    "artifacts:status": "node scripts/managed-artifact-catalog.mjs --json",
    "check:managed-artifacts": "node scripts/managed-artifact-catalog.mjs --check",
    "check:api-source-imports": "node scripts/check-source-imports.mjs packages/api/src",
    "test:run-sh": "node scripts/run-sh-contract.test.mjs",
    "check:run-target-catalog": "node scripts/check-run-target-catalog.mjs",
    "check:did-surface-discipline": "node scripts/check-did-surface-discipline.mjs",
    "test:did-surface-discipline": "node --test scripts/did-production-cast-rules.test.mjs",
    "check:workspace-manifests": "node scripts/check-workspace-manifests.mjs",
    "test:workspace-manifests": "node scripts/check-workspace-manifests.test.mjs",
    "test:artifact-workspaces": "node scripts/artifact-workspaces.test.mjs",
    "test:managed-artifacts": "node scripts/managed-artifact-catalog.test.mjs",
    "test:integration-report": "node scripts/report-integration.test.mjs",
    "check:source-imports": "node scripts/check-source-imports.mjs",
    "test:source-imports": "node scripts/check-source-imports.test.mjs"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/domain",
    "packages/did",
    "packages/jubjub-schnorr",
    "packages/contract",
    "docs-site"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "testcontainers": "^11.0.0",
    "turbo": "^2.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "^4.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.0.0",
    "@midnight-ntwrk/midnight-js-types": "^4.0.0",
    "@midnight-ntwrk/midnight-js-utils": "^4.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "^2.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^2.0.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.2",
    "zod": "^4.1.0",
    "@midnight-ntwrk/ledger-v8": "^8.0.0"
  },
  "eslintConfig": {
    "plugins": [
      "import",
      "simple-import-sort"
    ],
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "ignoreRestSiblings": true
        }
      ],
      "import/no-unused-modules": [
        1,
        {
          "unusedExports": true
        }
      ],
      "no-duplicate-imports": "error",
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error"
    }
  }
}
