{
  "name": "midnight-did",
  "version": "0.1.0",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "check:boundaries": "npm run checkdeps && npm run check:workspaces && node scripts/check-workspace-dependencies.mjs && npm run docs:check-v8-migration",
    "audit:repo": "node scripts/repository-audit.mjs",
    "clean": "npm run clean -w contract && npm run clean -w domain && npm run clean -w did && npm run clean -w api && npm run clean -w cli && npm run clean -w did-resolver-service",
    "clean:local-state": "rm -rf .turbo api/.midnight-db docs-site review/.midnight-db did-manager-service/.tmp did-manager-service/playwright-report did-manager-service/test-results 2>/dev/null || true",
    "run:metrics": "bash ./run.sh --metrics",
    "run:fast": "bash ./run.sh --skip-coverage",
    "lint": "npm run lint -w contract && npm run lint -w cli && npm run lint -w domain && npm run lint -w did && npm run lint -w api && npm run lint -w did-resolver-service",
    "lint:fix": "npm run lint:fix -w contract && npm run lint:fix -w cli && npm run lint:fix -w domain && npm run lint:fix -w did && npm run lint:fix -w api && npm run lint:fix -w did-resolver-service",
    "build:all": "npm run build -w contract && npm run build -w cli",
    "test:all": "npm run all -w contract && npm run test -w api",
    "coverage": "npm run coverage -w contract && npm run coverage -w domain && npm run coverage -w did && npm run coverage -w api && npm run coverage -w did-resolver-service",
    "ci": "npm run contract -w contract && npm run build -w contract && npm run all -w contract && npm run build -w cli && npm run test -w api",
    "pack:contract": "npm_config_cache=.npm-cache bash -lc 'cd contract && npm pack'",
    "pack:cli": "npm_config_cache=.npm-cache bash -lc 'cd cli && npm pack'",
    "pack:all": "npm run pack:contract && npm run pack:cli && echo 'Artifacts:' && ls -1 *.tgz || true && ls -1 contract/*.tgz cli/*.tgz || true",
    "checkdeps": "bash scripts/check-deps.sh",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:workspaces": "node scripts/validate-workspace-manifests.js",
    "run:strict": "bash ./run.sh --strict",
    "run:pipeline-checks": "npm run check:boundaries && bash ./run.sh --strict",
    "test:run-sh": "node scripts/run-sh-contract.test.mjs",
    "test:vc-profile": "node --test schemas/compact-vc/test/compact-vc-profile.test.mjs",
    "test:vc-status": "npm run test -w api -- src/test/vc-status-verification.test.ts",
    "test:trust-registry": "npm run test -w api -- src/test/trust-registry-contract.test.ts",
    "test:delegation": "npm run test -w api -- src/test/did-delegation-contract.test.ts",
    "test:university-bdd": "npm run test -w api -- src/test/university-bdd-flow.test.ts",
    "docs:check-mermaid": "node scripts/docs-mermaid.mjs check",
    "docs:check-v8-migration": "node scripts/check-v8-migration-stance.mjs",
    "docs:render": "node scripts/docs-mermaid.mjs render --format both --out-dir docs/assets/book-diagrams --manifest docs/assets/book-diagrams/manifest.json",
    "university-bdd:run": "npm run build -w api && node scripts/university-bdd-run.mjs",
    "university-bdd:diff": "node scripts/university-bdd-diff.mjs",
    "test:university-bdd:cli": "npm run build -w api && node --test scripts/university-bdd-run.test.mjs",
    "test:university-bdd:transport": "node --test scripts/university-bdd-transport-adapter.test.mjs",
    "test:university-bdd:tooling": "node --test scripts/university-bdd-tooling.test.mjs",
    "pr:snippet": "node scripts/repo-pr-snippet.mjs",
    "university-bdd:visualize": "node scripts/university-bdd-replay-visualize.mjs",
    "university-bdd:metrics": "node scripts/university-bdd-metrics.mjs",
    "university-bdd:pr-summary": "node scripts/university-bdd-pr-summary.mjs",
    "backlog:progress": "node scripts/backlog-progress.mjs"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "api",
    "domain",
    "did",
    "contract",
    "cli",
    "did-resolver-service"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "testcontainers": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/ledger": "^4.0.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.2",
    "zod": "^4.1.0"
  },
  "eslintConfig": {
    "plugins": [
      "import",
      "simple-import-sort"
    ],
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "ignoreRestSiblings": true
        }
      ],
      "import/no-unused-modules": [
        1,
        {
          "unusedExports": true
        }
      ],
      "no-duplicate-imports": "error",
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error"
    }
  }
}
