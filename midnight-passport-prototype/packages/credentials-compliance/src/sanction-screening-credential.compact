pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../../credentials-same-holder/src/same-holder";
include "./sanction-screening-credential/model";

import VC<SanctionScreeningCredentialClaims, SanctionScreeningCredentialDisclosures, BlindedSecretHolderBinding>;

export type SanctionScreeningCredential = Credential;
export type SanctionScreeningCredentialPresentation = Presentation;
include "./sanction-screening-credential/protocol-model";

import IssuanceProtocol<
  SanctionScreeningCredentialIssuanceOfferBody,
  SanctionScreeningCredentialIssuanceRequestBody,
  SanctionScreeningCredentialIssuanceResultBody
> prefix SanctionScreeningCredentialIssuance_;

import PresentationProtocol<
  SanctionScreeningCredentialVerificationRequestBody,
  SanctionScreeningCredentialVerificationSubmissionBody,
  SanctionScreeningCredentialVerificationResultBody
> prefix SanctionScreeningCredentialVerification_;

export type SanctionScreeningCredentialIssuanceOffer = SanctionScreeningCredentialIssuance_OfferMessage;
export type SanctionScreeningCredentialIssuanceRequest = SanctionScreeningCredentialIssuance_RequestMessage;
export type SanctionScreeningCredentialIssuanceResult = SanctionScreeningCredentialIssuance_ResultMessage;
export type SanctionScreeningCredentialVerificationRequest = SanctionScreeningCredentialVerification_RequestMessage;
export type SanctionScreeningCredentialVerificationSubmission = SanctionScreeningCredentialVerification_SubmissionMessage;
export type SanctionScreeningCredentialVerificationResult = SanctionScreeningCredentialVerification_ResultMessage;
include "./sanction-screening-credential/helpers";
include "./sanction-screening-credential/validation";
