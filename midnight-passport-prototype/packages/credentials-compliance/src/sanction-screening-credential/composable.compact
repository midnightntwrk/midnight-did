// Composition-safe entry point for Layer 3 contracts. The importing contract
// must include shared dependencies such as credentials and same-holder exactly
// once before including this file.

include "./model";

import VC<SanctionScreeningCredentialClaims, SanctionScreeningCredentialDisclosures, BlindedSecretHolderBinding> prefix SanctionScreeningCredentialVC_;

export type SanctionScreeningCredential = SanctionScreeningCredentialVC_Credential;
export type SanctionScreeningCredentialPresentation = SanctionScreeningCredentialVC_Presentation;

export circuit sanctionScreeningCredentialGenericBodyRoot(
  credential: SanctionScreeningCredential
): Bytes<32> {
  return SanctionScreeningCredentialVC_credentialBodyRoot(credential);
}

export circuit sanctionScreeningCredentialGenericPresentationBodyRoot(
  presentation: SanctionScreeningCredentialPresentation
): Bytes<32> {
  return SanctionScreeningCredentialVC_presentationBodyRoot(presentation);
}

export circuit assertValidSanctionScreeningCredentialEnvelope(
  credential: SanctionScreeningCredential,
  expectedClaimRoot: Bytes<32>
): [] {
  SanctionScreeningCredentialVC_assertValidCredentialEnvelope(credential, expectedClaimRoot);
}

export circuit assertValidSanctionScreeningCredentialProofEnvelope(
  credential: SanctionScreeningCredential,
  proof: Proof
): [] {
  SanctionScreeningCredentialVC_assertValidCredentialProof(credential, proof);
}

export circuit assertValidSanctionScreeningPresentationEnvelope(
  credential: SanctionScreeningCredential,
  presentation: SanctionScreeningCredentialPresentation
): [] {
  SanctionScreeningCredentialVC_assertValidPresentationEnvelope(credential, presentation);
}

include "./protocol-model";

import IssuanceProtocol<
  SanctionScreeningCredentialIssuanceOfferBody,
  SanctionScreeningCredentialIssuanceRequestBody,
  SanctionScreeningCredentialIssuanceResultBody
> prefix SanctionScreeningCredentialIssuance_;

import PresentationProtocol<
  SanctionScreeningCredentialVerificationRequestBody,
  SanctionScreeningCredentialVerificationSubmissionBody,
  SanctionScreeningCredentialVerificationResultBody
> prefix SanctionScreeningCredentialVerification_;

export type SanctionScreeningCredentialIssuanceOffer = SanctionScreeningCredentialIssuance_OfferMessage;
export type SanctionScreeningCredentialIssuanceRequest = SanctionScreeningCredentialIssuance_RequestMessage;
export type SanctionScreeningCredentialIssuanceResult = SanctionScreeningCredentialIssuance_ResultMessage;
export type SanctionScreeningCredentialVerificationRequest = SanctionScreeningCredentialVerification_RequestMessage;
export type SanctionScreeningCredentialVerificationSubmission = SanctionScreeningCredentialVerification_SubmissionMessage;
export type SanctionScreeningCredentialVerificationResult = SanctionScreeningCredentialVerification_ResultMessage;

include "./helpers";
include "./validation";
