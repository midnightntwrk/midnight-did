// Composition-safe entry point for Layer 3 contracts. The importing contract
// must include shared dependencies such as credentials, same-holder, and the ISO
// registry exactly once before including this file.

include "../../../credentials-passport/src/passport-credential/claims";
include "./model";

import VC<PassportCredentialClaims, SecretPassportCredentialDisclosures, BlindedSecretHolderBinding> prefix SecretPassportCredentialVC_;

export type SecretPassportCredential = SecretPassportCredentialVC_Credential;
export type SecretPassportCredentialPresentation = SecretPassportCredentialVC_Presentation;

export circuit secretPassportCredentialGenericBodyRoot(
  credential: SecretPassportCredential
): Bytes<32> {
  return SecretPassportCredentialVC_credentialBodyRoot(credential);
}

export circuit secretPassportCredentialGenericPresentationBodyRoot(
  presentation: SecretPassportCredentialPresentation
): Bytes<32> {
  return SecretPassportCredentialVC_presentationBodyRoot(presentation);
}

export circuit assertValidSecretPassportCredentialEnvelope(
  credential: SecretPassportCredential,
  expectedClaimRoot: Bytes<32>
): [] {
  SecretPassportCredentialVC_assertValidCredentialEnvelope(credential, expectedClaimRoot);
}

export circuit assertValidSecretPassportCredentialProofEnvelope(
  credential: SecretPassportCredential,
  proof: Proof
): [] {
  SecretPassportCredentialVC_assertValidCredentialProof(credential, proof);
}

export circuit assertValidSecretPassportPresentationEnvelope(
  credential: SecretPassportCredential,
  presentation: SecretPassportCredentialPresentation
): [] {
  SecretPassportCredentialVC_assertValidPresentationEnvelope(credential, presentation);
}

include "./protocol-model";

import IssuanceProtocol<
  SecretPassportCredentialIssuanceOfferBody,
  SecretPassportCredentialIssuanceRequestBody,
  SecretPassportCredentialIssuanceResultBody
> prefix SecretPassportCredentialIssuance_;

import PresentationProtocol<
  SecretPassportCredentialVerificationRequestBody,
  SecretPassportCredentialVerificationSubmissionBody,
  SecretPassportCredentialVerificationResultBody
> prefix SecretPassportCredentialVerification_;

export type SecretPassportCredentialIssuanceOffer = SecretPassportCredentialIssuance_OfferMessage;
export type SecretPassportCredentialIssuanceRequest = SecretPassportCredentialIssuance_RequestMessage;
export type SecretPassportCredentialIssuanceResult = SecretPassportCredentialIssuance_ResultMessage;
export type SecretPassportCredentialVerificationRequest = SecretPassportCredentialVerification_RequestMessage;
export type SecretPassportCredentialVerificationSubmission = SecretPassportCredentialVerification_SubmissionMessage;
export type SecretPassportCredentialVerificationResult = SecretPassportCredentialVerification_ResultMessage;

include "./helpers";
include "./validation";
