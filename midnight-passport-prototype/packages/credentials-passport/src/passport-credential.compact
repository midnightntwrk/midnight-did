pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../../credentials/src/credentials";
include "../../../../credentials-iso-registry/src/iso-registry";
include "./passport-credential/claims";
include "./passport-credential/model";

import VC<PassportCredentialClaims, PassportCredentialDisclosures, ExplicitHolderBinding>;

export type PassportCredential = Credential;
export type PassportCredentialPresentation = Presentation;
include "./passport-credential/protocol-model";

import IssuanceProtocol<
  PassportCredentialIssuanceOfferBody,
  PassportCredentialIssuanceRequestBody,
  PassportCredentialIssuanceResultBody
> prefix PassportCredentialIssuance_;

import PresentationProtocol<
  PassportCredentialVerificationRequestBody,
  PassportCredentialVerificationSubmissionBody,
  PassportCredentialVerificationResultBody
> prefix PassportCredentialVerification_;

export type PassportCredentialIssuanceOffer = PassportCredentialIssuance_OfferMessage;
export type PassportCredentialIssuanceRequest = PassportCredentialIssuance_RequestMessage;
export type PassportCredentialIssuanceResult = PassportCredentialIssuance_ResultMessage;
export type PassportCredentialVerificationRequest = PassportCredentialVerification_RequestMessage;
export type PassportCredentialVerificationSubmission = PassportCredentialVerification_SubmissionMessage;
export type PassportCredentialVerificationResult = PassportCredentialVerification_ResultMessage;
include "./passport-credential/helpers";
include "./passport-credential/validation";
