pragma language_version >= 0.20;

import CompactStandardLibrary;

export struct SchemaRef {
  packageId: Bytes<32>,
  schemaId: Bytes<32>,
  majorVersion: Uint<16>,
  minorVersion: Uint<16>,
}

export struct VerificationMethodId {
  didContractAddress: ContractAddress,
  methodIndex: Uint<16>,
}

export struct Signature {
  r: JubjubPoint,
  s: Field,
}

export struct HolderBinding {
  holderVerificationMethodId: VerificationMethodId,
}

// Proof is kept separate from the VC/VP body on purpose.
// The body is the semantic payload; the proof is the cryptographic artifact
// over that payload plus interaction context.
export struct Proof {
  signerVerificationMethodId: VerificationMethodId,
  createdAt: Uint<64>,
  challengeHash: Bytes<32>,
  publicKey: JubjubPoint,
  signature: Signature,
}

module VC<TClaims, TDisclosures> {
  export struct Credential {
    version: Uint<16>,
    schema: SchemaRef,
    issuerVerificationMethodId: VerificationMethodId,
    holderBinding: HolderBinding,
    issuedAt: Uint<64>,
    hasExpiration: Boolean,
    expiresAt: Uint<64>,
    claims: TClaims,
    claimRoot: Bytes<32>,
  }

  export struct Presentation {
    version: Uint<16>,
    schema: SchemaRef,
    credentialClaimRoot: Bytes<32>,
    issuerVerificationMethodId: VerificationMethodId,
    holderBinding: HolderBinding,
    disclosed: TDisclosures,
  }

  export circuit credentialBodyRoot(credential: Credential): Bytes<32> {
    return persistentHash<Credential>(credential);
  }

  export circuit presentationBodyRoot(presentation: Presentation): Bytes<32> {
    return persistentHash<Presentation>(presentation);
  }

  export circuit assertValidCredentialEnvelope(
    credential: Credential,
    expectedClaimRoot: Bytes<32>
  ): [] {
    assert(credential.version == 1, "Credential version mismatch");
    assert(credential.claimRoot == expectedClaimRoot, "Credential claim root mismatch");
    assert(
      credential.holderBinding.holderVerificationMethodId.methodIndex > 0,
      "Holder binding method index must be positive"
    );
    if (credential.hasExpiration) {
      assert(credential.expiresAt >= credential.issuedAt, "Expiration must not precede issuance");
    }
  }

  export circuit assertValidCredentialProof(
    credential: Credential,
    proof: Proof
  ): [] {
    const bodyRoot: Bytes<32> = credentialBodyRoot(credential);
    assert(
      credential.issuerVerificationMethodId.didContractAddress == proof.signerVerificationMethodId.didContractAddress,
      "Issuer proof contract address does not match issuer verification method"
    );
    assert(
      credential.issuerVerificationMethodId.methodIndex == proof.signerVerificationMethodId.methodIndex,
      "Issuer proof method index does not match issuer verification method"
    );
    assertValidIssuanceContextProof(bodyRoot, proof);
  }

  export circuit assertValidPresentationEnvelope(
    credential: Credential,
    presentation: Presentation
  ): [] {
    assert(presentation.version == 1, "Presentation version mismatch");
    assert(
      presentation.credentialClaimRoot == credential.claimRoot,
      "Presentation must reference the credential claim root"
    );
    assert(
      presentation.issuerVerificationMethodId.didContractAddress == credential.issuerVerificationMethodId.didContractAddress,
      "Presentation issuer contract does not match credential issuer"
    );
    assert(
      presentation.issuerVerificationMethodId.methodIndex == credential.issuerVerificationMethodId.methodIndex,
      "Presentation issuer method does not match credential issuer"
    );
    assert(
      presentation.holderBinding.holderVerificationMethodId.didContractAddress
        == credential.holderBinding.holderVerificationMethodId.didContractAddress,
      "Presentation holder contract does not match credential holder binding"
    );
    assert(
      presentation.holderBinding.holderVerificationMethodId.methodIndex
        == credential.holderBinding.holderVerificationMethodId.methodIndex,
      "Presentation holder method does not match credential holder binding"
    );
  }

  export circuit assertValidPresentationProof(
    presentation: Presentation,
    presentationProof: Proof
  ): [] {
    const bodyRoot: Bytes<32> = presentationBodyRoot(presentation);
    assert(
      presentation.holderBinding.holderVerificationMethodId.didContractAddress
        == presentationProof.signerVerificationMethodId.didContractAddress,
      "Presentation proof signer must match holder binding"
    );
    assert(
      presentation.holderBinding.holderVerificationMethodId.methodIndex
        == presentationProof.signerVerificationMethodId.methodIndex,
      "Presentation proof signer method must match holder binding"
    );
    assertValidPresentationContextProof(bodyRoot, presentationProof);
  }
}

export circuit verifySignature(
  pk: JubjubPoint,
  signature: Signature,
  challenge: Field
): Boolean {
  const leftSide: JubjubPoint = ecMulGenerator(signature.s);
  const cPk: JubjubPoint = ecMul(pk, challenge);
  const rightSide: JubjubPoint = ecAdd(signature.r, cPk);
  const xMatches: Boolean = jubjubPointX(leftSide) == jubjubPointX(rightSide);
  const yMatches: Boolean = jubjubPointY(leftSide) == jubjubPointY(rightSide);
  assert(xMatches && yMatches, "Signature verification failed");
  return xMatches && yMatches;
}

// The proof object does not carry a purpose field. Instead, the verifier
// chooses the context-specific challenge derivation helper, which gives us
// explicit domain separation without asking callers to populate a mutable enum.
export circuit issuanceContextTag(): Bytes<32> {
  return pad(32, "midnight:vc:issuance");
}

export circuit presentationContextTag(): Bytes<32> {
  return pad(32, "midnight:vc:presentation");
}

circuit proofPayloadRootForContext(
  bodyRoot: Bytes<32>,
  contextTag: Bytes<32>,
  proof: Proof
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    bodyRoot,
    contextTag,
    persistentHash<VerificationMethodId>(proof.signerVerificationMethodId),
    upgradeFromTransient(transientHash<Uint<64>>(proof.createdAt)),
    proof.challengeHash
  ]);
}

circuit proofChallengeForContext(
  bodyRoot: Bytes<32>,
  contextTag: Bytes<32>,
  proof: Proof
): Field {
  return degradeToTransient(persistentHash<Vector<3, Bytes<32>>>([
    proofPayloadRootForContext(bodyRoot, contextTag, proof),
    upgradeFromTransient(transientHash<JubjubPoint>(proof.publicKey)),
    upgradeFromTransient(transientHash<JubjubPoint>(proof.signature.r))
  ]));
}

circuit assertValidProofForContext(
  bodyRoot: Bytes<32>,
  contextTag: Bytes<32>,
  proof: Proof
): [] {
  assert(proof.signerVerificationMethodId.methodIndex > 0, "Verification method index must be positive");
  assert(
    verifySignature(
      proof.publicKey,
      proof.signature,
      proofChallengeForContext(bodyRoot, contextTag, proof)
    ),
    "Proof verification failed"
  );
}

export circuit issuanceProofPayloadRoot(
  bodyRoot: Bytes<32>,
  proof: Proof
): Bytes<32> {
  return proofPayloadRootForContext(bodyRoot, issuanceContextTag(), proof);
}

export circuit presentationProofPayloadRoot(
  bodyRoot: Bytes<32>,
  proof: Proof
): Bytes<32> {
  return proofPayloadRootForContext(bodyRoot, presentationContextTag(), proof);
}

export circuit issuanceProofChallenge(
  bodyRoot: Bytes<32>,
  proof: Proof
): Field {
  return proofChallengeForContext(bodyRoot, issuanceContextTag(), proof);
}

export circuit presentationProofChallenge(
  bodyRoot: Bytes<32>,
  proof: Proof
): Field {
  return proofChallengeForContext(bodyRoot, presentationContextTag(), proof);
}

// The proof container is generic, but the verification context is explicit.
export circuit assertValidIssuanceContextProof(
  bodyRoot: Bytes<32>,
  proof: Proof
): [] {
  assertValidProofForContext(bodyRoot, issuanceContextTag(), proof);
}

export circuit assertValidPresentationContextProof(
  bodyRoot: Bytes<32>,
  proof: Proof
): [] {
  assertValidProofForContext(bodyRoot, presentationContextTag(), proof);
}
