pragma language_version >= 0.20;

import CompactStandardLibrary;

export enum CredentialTypeId {
  Undefined,
  BirthCredential,
  BirthCredentialPresentation
}

export enum CredentialProofPurpose {
  Undefined,
  CredentialIssuance,
  PresentationAuthentication
}

export struct SchemaRef {
  packageId: Bytes<32>,
  schemaId: Bytes<32>,
  majorVersion: Uint<16>,
  minorVersion: Uint<16>,
}

export struct VerificationMethodId {
  didContractAddress: ContractAddress,
  methodIndex: Uint<16>,
}

export struct JubjubSignature {
  r: JubjubPoint,
  s: Field,
}

// Proof is kept separate from the VC/VP body on purpose.
// The body is the semantic payload; the proof is the cryptographic artifact
// over that payload plus interaction context.
export struct JubjubCredentialProof {
  purpose: CredentialProofPurpose,
  signerVerificationMethodId: VerificationMethodId,
  createdAt: Uint<64>,
  // Required anti-replay binding value supplied by the issuance/presentation flow.
  challengeHash: Bytes<32>,
  publicKey: JubjubPoint,
  signature: JubjubSignature,
}

// Claim commitments anchor private claim values without exposing them in the
// public contract-facing credential shape.
export struct BirthCredentialClaimCommitments {
  subjectIdCommitment: Bytes<32>,
  legalNameCommitment: Bytes<32>,
  birthDateCommitment: Bytes<32>,
  birthCountryCodeCommitment: Bytes<32>,
}

export struct HolderBinding {
  holderVerificationMethodId: VerificationMethodId,
}

// Credential body only. Proof is validated alongside this structure, not inside it.
export struct BirthCredential {
  version: Uint<16>,
  credentialType: CredentialTypeId,
  schema: SchemaRef,
  issuerVerificationMethodId: VerificationMethodId,
  holderBinding: HolderBinding,
  issuedAt: Uint<64>,
  hasExpiration: Boolean,
  expiresAt: Uint<64>,
  claims: BirthCredentialClaimCommitments,
  // Root commitment over the ordered set of claim commitments.
  claimRoot: Bytes<32>,
}

export struct BirthCredentialDisclosures {
  revealSubjectIdCommitment: Boolean,
  subjectIdCommitment: Bytes<32>,
  revealBirthCountryCode: Boolean,
  birthCountryCodePadded: Bytes<32>,
  birthCountryCodeOpening: Bytes<32>,
  proveAgeOverThreshold: Boolean,
  ageThresholdYears: Uint<8>,
}

export struct BirthCredentialPresentation {
  version: Uint<16>,
  credentialType: CredentialTypeId,
  schema: SchemaRef,
  // The presentation points back to the issued credential via the claim root.
  credentialClaimRoot: Bytes<32>,
  issuerVerificationMethodId: VerificationMethodId,
  holderBinding: HolderBinding,
  disclosed: BirthCredentialDisclosures,
}

export circuit verifyJubjubSignature(
  pk: JubjubPoint,
  signature: JubjubSignature,
  challenge: Field
): Boolean {
  const leftSide: JubjubPoint = ecMulGenerator(signature.s);
  const cPk: JubjubPoint = ecMul(pk, challenge);
  const rightSide: JubjubPoint = ecAdd(signature.r, cPk);
  const xMatches: Boolean = jubjubPointX(leftSide) == jubjubPointX(rightSide);
  const yMatches: Boolean = jubjubPointY(leftSide) == jubjubPointY(rightSide);
  assert(xMatches && yMatches, "Jubjub signature verification failed");
  return xMatches && yMatches;
}

export circuit birthCredentialBodyRoot(credential: BirthCredential): Bytes<32> {
  return persistentHash<BirthCredential>(credential);
}

export circuit birthCredentialPresentationBodyRoot(presentation: BirthCredentialPresentation): Bytes<32> {
  return persistentHash<BirthCredentialPresentation>(presentation);
}

export circuit birthCredentialClaimRoot(claims: BirthCredentialClaimCommitments): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "midnight:vc:birth:v1"),
    claims.subjectIdCommitment,
    claims.legalNameCommitment,
    claims.birthDateCommitment,
    claims.birthCountryCodeCommitment
  ]);
}

export circuit subjectIdCommitment(subjectId: Bytes<32>, opening: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(subjectId, opening);
}

export circuit birthDateCommitment(birthDateDays: Uint<32>, opening: Bytes<32>): Bytes<32> {
  return persistentCommit<Uint<32>>(birthDateDays, opening);
}

export circuit legalNameCommitment(legalNamePadded: Bytes<32>, opening: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(legalNamePadded, opening);
}

export circuit birthCountryCodeCommitment(
  birthCountryCodePadded: Bytes<32>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<32>>(birthCountryCodePadded, opening);
}

export circuit jubjubProofPayloadRoot(
  bodyRoot: Bytes<32>,
  proof: JubjubCredentialProof
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    bodyRoot,
    upgradeFromTransient(transientHash<CredentialProofPurpose>(proof.purpose)),
    persistentHash<VerificationMethodId>(proof.signerVerificationMethodId),
    upgradeFromTransient(transientHash<Uint<64>>(proof.createdAt)),
    proof.challengeHash
  ]);
}

export circuit jubjubProofChallenge(
  bodyRoot: Bytes<32>,
  proof: JubjubCredentialProof
): Field {
  return degradeToTransient(persistentHash<Vector<3, Bytes<32>>>([
    jubjubProofPayloadRoot(bodyRoot, proof),
    upgradeFromTransient(transientHash<JubjubPoint>(proof.publicKey)),
    upgradeFromTransient(transientHash<JubjubPoint>(proof.signature.r))
  ]));
}

// Validates the bounded proof container against the body it is supposed to sign.
export circuit assertValidJubjubCredentialProof(
  bodyRoot: Bytes<32>,
  proof: JubjubCredentialProof
): [] {
  assert(proof.purpose != CredentialProofPurpose.Undefined, "Proof purpose must be defined");
  assert(proof.signerVerificationMethodId.methodIndex > 0, "Verification method index must be positive");
  assert(
    verifyJubjubSignature(proof.publicKey, proof.signature, jubjubProofChallenge(bodyRoot, proof)),
    "Jubjub proof verification failed"
  );
}

export circuit assertValidBirthSchemaRef(schema: SchemaRef): [] {
  assert(schema.packageId == pad(32, "midnight-did:vc"), "Unexpected schema package identifier");
  assert(schema.schemaId == pad(32, "birth-credential:v1"), "Unexpected schema identifier");
  assert(schema.majorVersion == 1, "Birth credential major version mismatch");
}

// Validates the semantic credential body against the separate issuer proof.
export circuit assertValidBirthCredential(credential: BirthCredential, proof: JubjubCredentialProof): [] {
  const credentialBodyRoot: Bytes<32> = birthCredentialBodyRoot(credential);
  assert(credential.version == 1, "Credential version mismatch");
  assert(credential.credentialType == CredentialTypeId.BirthCredential, "Credential type mismatch");
  assertValidBirthSchemaRef(credential.schema);
  assert(credential.claimRoot == birthCredentialClaimRoot(credential.claims), "Credential claim root mismatch");
  assert(credential.holderBinding.holderVerificationMethodId.methodIndex > 0, "Holder binding method index must be positive");
  if (credential.hasExpiration) {
    assert(credential.expiresAt >= credential.issuedAt, "Expiration must not precede issuance");
  }
  assert(
    proof.purpose == CredentialProofPurpose.CredentialIssuance,
    "Credential proof must use issuance purpose"
  );
  assert(
    credential.issuerVerificationMethodId.didContractAddress == proof.signerVerificationMethodId.didContractAddress,
    "Issuer proof contract address does not match issuer verification method"
  );
  assert(
    credential.issuerVerificationMethodId.methodIndex == proof.signerVerificationMethodId.methodIndex,
    "Issuer proof method index does not match issuer verification method"
  );
  assertValidJubjubCredentialProof(credentialBodyRoot, proof);
}

// Validates the semantic presentation body against the separate holder proof
// and checks that it remains anchored to the issued credential.
export circuit assertValidBirthCredentialPresentation(
  credential: BirthCredential,
  credentialProof: JubjubCredentialProof,
  presentation: BirthCredentialPresentation,
  presentationProof: JubjubCredentialProof
): [] {
  const presentationBodyRoot: Bytes<32> = birthCredentialPresentationBodyRoot(presentation);
  assertValidBirthCredential(credential, credentialProof);

  assert(presentation.version == 1, "Presentation version mismatch");
  assert(
    presentation.credentialType == CredentialTypeId.BirthCredentialPresentation,
    "Presentation type mismatch"
  );
  assertValidBirthSchemaRef(presentation.schema);
  assert(
    presentation.credentialClaimRoot == credential.claimRoot,
    "Presentation must reference the credential claim root"
  );
  assert(
    presentation.issuerVerificationMethodId.didContractAddress == credential.issuerVerificationMethodId.didContractAddress,
    "Presentation issuer contract does not match credential issuer"
  );
  assert(
    presentation.issuerVerificationMethodId.methodIndex == credential.issuerVerificationMethodId.methodIndex,
    "Presentation issuer method does not match credential issuer"
  );
  assert(
    presentation.holderBinding.holderVerificationMethodId.didContractAddress
      == credential.holderBinding.holderVerificationMethodId.didContractAddress,
    "Presentation holder contract does not match credential holder binding"
  );
  assert(
    presentation.holderBinding.holderVerificationMethodId.methodIndex
      == credential.holderBinding.holderVerificationMethodId.methodIndex,
    "Presentation holder method does not match credential holder binding"
  );
  if (presentation.disclosed.revealSubjectIdCommitment) {
    assert(
      presentation.disclosed.subjectIdCommitment == credential.claims.subjectIdCommitment,
      "Presentation subject commitment does not match the credential"
    );
  }
  if (presentation.disclosed.revealBirthCountryCode) {
    assert(
      birthCountryCodeCommitment(
        presentation.disclosed.birthCountryCodePadded,
        presentation.disclosed.birthCountryCodeOpening
      ) == credential.claims.birthCountryCodeCommitment,
      "Presentation birth-country disclosure does not match the credential"
    );
  }
  if (presentation.disclosed.proveAgeOverThreshold) {
    assert(presentation.disclosed.ageThresholdYears > 0, "Age threshold must be positive");
  }
  assert(
    presentationProof.purpose == CredentialProofPurpose.PresentationAuthentication,
    "Presentation proof must use authentication purpose"
  );
  assert(
    presentation.holderBinding.holderVerificationMethodId.didContractAddress
      == presentationProof.signerVerificationMethodId.didContractAddress,
    "Presentation proof signer must match holder binding"
  );
  assert(
    presentation.holderBinding.holderVerificationMethodId.methodIndex
      == presentationProof.signerVerificationMethodId.methodIndex,
    "Presentation proof signer method must match holder binding"
  );
  assertValidJubjubCredentialProof(presentationBodyRoot, presentationProof);
}

export circuit assertValidBirthCredentialAgePredicate(
  credential: BirthCredential,
  presentation: BirthCredentialPresentation,
  currentDay: Uint<32>,
  birthDateDays: Uint<32>,
  birthDateOpening: Bytes<32>
): [] {
  assert(
    presentation.disclosed.proveAgeOverThreshold,
    "Presentation must request the age-over-threshold predicate"
  );
  assert(
    birthDateCommitment(birthDateDays, birthDateOpening) == credential.claims.birthDateCommitment,
    "Birth-date witness does not match credential commitment"
  );
  assert(currentDay >= birthDateDays, "Current day must not precede the birth date witness");
  assert(
    currentDay - birthDateDays >= presentation.disclosed.ageThresholdYears * 365,
    "Age predicate does not satisfy the requested threshold"
  );
}
