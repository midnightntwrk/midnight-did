pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../credentials-same-holder/src/same-holder";
include "../../credentials-birth/src/birth-credential/claims";
include "./secret-birth-credential/model";

import VC<BirthCredentialClaims, SecretBirthCredentialDisclosures, BlindedSecretHolderBinding>;

export type SecretBirthCredential = Credential;
export type SecretBirthCredentialPresentation = Presentation;
include "./secret-birth-credential/protocol-model";

import IssuanceProtocol<
  SecretBirthCredentialIssuanceOfferBody,
  SecretBirthCredentialIssuanceRequestBody,
  SecretBirthCredentialIssuanceResultBody
> prefix SecretBirthCredentialIssuance_;

import PresentationProtocol<
  SecretBirthCredentialVerificationRequestBody,
  SecretBirthCredentialVerificationSubmissionBody,
  SecretBirthCredentialVerificationResultBody
> prefix SecretBirthCredentialVerification_;

export type SecretBirthCredentialIssuanceOffer = SecretBirthCredentialIssuance_OfferMessage;
export type SecretBirthCredentialIssuanceRequest = SecretBirthCredentialIssuance_RequestMessage;
export type SecretBirthCredentialIssuanceResult = SecretBirthCredentialIssuance_ResultMessage;
export type SecretBirthCredentialVerificationRequest = SecretBirthCredentialVerification_RequestMessage;
export type SecretBirthCredentialVerificationSubmission = SecretBirthCredentialVerification_SubmissionMessage;
export type SecretBirthCredentialVerificationResult = SecretBirthCredentialVerification_ResultMessage;
include "./secret-birth-credential/helpers";
include "./secret-birth-credential/validation";
