pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../credentials/src/credentials";

export struct BirthCredentialClaims {
  subjectIdCommitment: Bytes<32>,
  legalNameCommitment: Bytes<32>,
  birthDateCommitment: Bytes<32>,
  birthCountryCodeCommitment: Bytes<32>,
}

export struct BirthCredentialDisclosures {
  revealSubjectIdCommitment: Boolean,
  subjectIdCommitment: Bytes<32>,
  revealBirthCountryCode: Boolean,
  birthCountryCodePadded: Bytes<32>,
  birthCountryCodeOpening: Bytes<32>,
  revealVerifierScopedPseudonym: Boolean,
  verifierScopedPseudonym: Bytes<32>,
  proveAgeOverThreshold: Boolean,
  ageThresholdYears: Uint<8>,
}

export struct BirthCredentialPresentationRequest {
  version: Uint<16>,
  schema: SchemaRef,
  issuerVerificationMethodId: VerificationMethodId,
  requireSubjectIdCommitmentDisclosure: Boolean,
  requireBirthCountryDisclosure: Boolean,
  requireVerifierScopedPseudonym: Boolean,
  verifierDomainHash: Bytes<32>,
  requireAgeOverThreshold: Boolean,
  requestedAgeThresholdYears: Uint<8>,
  verifierChallengeHash: Bytes<32>,
}

import VC<BirthCredentialClaims, BirthCredentialDisclosures, BlindedSecretHolderBinding>;

export type SecretBirthCredential = Credential;
export type SecretBirthCredentialPresentation = Presentation;

export circuit secretBirthCredentialBodyRoot(
  credential: SecretBirthCredential
): Bytes<32> {
  return credentialBodyRoot(credential);
}

export circuit secretBirthCredentialPresentationBodyRoot(
  presentation: SecretBirthCredentialPresentation
): Bytes<32> {
  return presentationBodyRoot(presentation);
}

export circuit birthCredentialPresentationRequestBodyRoot(
  request: BirthCredentialPresentationRequest
): Bytes<32> {
  return persistentHash<BirthCredentialPresentationRequest>(request);
}

export circuit birthCredentialClaimRoot(claims: BirthCredentialClaims): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "midnight:vc:birth:v1"),
    claims.subjectIdCommitment,
    claims.legalNameCommitment,
    claims.birthDateCommitment,
    claims.birthCountryCodeCommitment
  ]);
}

export circuit subjectIdCommitment(subjectId: Bytes<32>, opening: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(subjectId, opening);
}

export circuit birthDateCommitment(birthDateDays: Uint<32>, opening: Bytes<32>): Bytes<32> {
  return persistentCommit<Uint<32>>(birthDateDays, opening);
}

export circuit legalNameCommitment(legalNamePadded: Bytes<32>, opening: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(legalNamePadded, opening);
}

export circuit birthCountryCodeCommitment(
  birthCountryCodePadded: Bytes<32>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<32>>(birthCountryCodePadded, opening);
}

export circuit assertValidSecretBirthSchemaRef(schema: SchemaRef): [] {
  assert(
    schema.packageId == pad(32, "midnight-did:vc:birth-secret"),
    "Unexpected secret birth schema package identifier"
  );
  assert(schema.schemaId == pad(32, "birth-credential:v1"), "Unexpected schema identifier");
  assert(schema.majorVersion == 1, "Secret birth credential major version mismatch");
}

export circuit assertValidBirthCredentialPresentationRequest(
  request: BirthCredentialPresentationRequest
): [] {
  assert(request.version == 1, "Presentation request version mismatch");
  assertValidSecretBirthSchemaRef(request.schema);
  assert(
    request.issuerVerificationMethodId.methodIndex > 0,
    "Request issuer method index must be positive"
  );
  if (request.requireAgeOverThreshold) {
    assert(request.requestedAgeThresholdYears > 0, "Requested age threshold must be positive");
  } else {
    assert(request.requestedAgeThresholdYears == 0, "Requested age threshold must be zero when disabled");
  }
}

export circuit assertValidSecretBirthCredential(
  credential: SecretBirthCredential,
  proof: Proof
): [] {
  assertValidSecretBirthSchemaRef(credential.schema);
  assertValidCredentialEnvelope(credential, birthCredentialClaimRoot(credential.claims));
  assertValidBlindedSecretHolderCredentialBinding(credential.holderBinding);
  assertValidCredentialProof(credential, proof);
}

export circuit assertValidSecretBirthCredentialPresentation(
  credential: SecretBirthCredential,
  credentialProof: Proof,
  presentation: SecretBirthCredentialPresentation
): [] {
  assertValidSecretBirthCredential(credential, credentialProof);
  assertValidSecretBirthSchemaRef(presentation.schema);
  assertValidPresentationEnvelope(credential, presentation);
  assertValidBlindedSecretHolderPresentationBinding(presentation.holderBinding);
  assertMatchingBlindedSecretHolderBindings(
    credential.holderBinding,
    presentation.holderBinding
  );

  if (presentation.disclosed.revealSubjectIdCommitment) {
    assert(
      presentation.disclosed.subjectIdCommitment == credential.claims.subjectIdCommitment,
      "Presentation subject commitment does not match the credential"
    );
  }
  if (presentation.disclosed.revealBirthCountryCode) {
    assert(
      birthCountryCodeCommitment(
        presentation.disclosed.birthCountryCodePadded,
        presentation.disclosed.birthCountryCodeOpening
      ) == credential.claims.birthCountryCodeCommitment,
      "Presentation birth-country disclosure does not match the credential"
    );
  }
  if (presentation.disclosed.revealVerifierScopedPseudonym) {
    assert(
      presentation.disclosed.verifierScopedPseudonym != pad(32, ""),
      "Presentation verifier-scoped pseudonym must be set when enabled"
    );
  }
  if (presentation.disclosed.proveAgeOverThreshold) {
    assert(presentation.disclosed.ageThresholdYears > 0, "Age threshold must be positive");
  }
}

export circuit assertSecretBirthPresentationSatisfiesRequest(
  credential: SecretBirthCredential,
  credentialProof: Proof,
  request: BirthCredentialPresentationRequest,
  presentation: SecretBirthCredentialPresentation,
  holderSecret: Bytes<32>,
  holderSecretOpening: Bytes<32>,
  holderBindingBlindingFactor: Bytes<32>
): [] {
  assertValidBirthCredentialPresentationRequest(request);
  assertValidSecretBirthCredentialPresentation(
    credential,
    credentialProof,
    presentation
  );
  assert(
    request.schema.packageId == credential.schema.packageId
      && request.schema.schemaId == credential.schema.schemaId
      && request.schema.majorVersion == credential.schema.majorVersion
      && request.schema.minorVersion == credential.schema.minorVersion,
    "Presentation request schema does not match the credential"
  );
  assert(
    request.issuerVerificationMethodId.didContractAddress == credential.issuerVerificationMethodId.didContractAddress,
    "Presentation request issuer contract does not match the credential issuer"
  );
  assert(
    request.issuerVerificationMethodId.methodIndex == credential.issuerVerificationMethodId.methodIndex,
    "Presentation request issuer method index does not match the credential issuer"
  );
  assertBlindedSecretHolderBindingWitness(
    presentation.holderBinding,
    request.verifierChallengeHash,
    holderSecret,
    holderSecretOpening,
    holderBindingBlindingFactor
  );
  if (request.requireSubjectIdCommitmentDisclosure) {
    assert(
      presentation.disclosed.revealSubjectIdCommitment,
      "Presentation request requires the subject-id commitment disclosure"
    );
  }
  if (request.requireBirthCountryDisclosure) {
    assert(
      presentation.disclosed.revealBirthCountryCode,
      "Presentation request requires the birth-country disclosure"
    );
  }
  if (request.requireVerifierScopedPseudonym) {
    assert(
      presentation.disclosed.revealVerifierScopedPseudonym,
      "Presentation request requires a verifier-scoped pseudonym"
    );
  }
  if (presentation.disclosed.revealVerifierScopedPseudonym) {
    assertVerifierScopedPseudonym(
      presentation.disclosed.verifierScopedPseudonym,
      holderSecret,
      request.verifierDomainHash
    );
  }
  if (request.requireAgeOverThreshold) {
    assert(
      presentation.disclosed.proveAgeOverThreshold,
      "Presentation request requires the age-over-threshold predicate"
    );
    assert(
      presentation.disclosed.ageThresholdYears == request.requestedAgeThresholdYears,
      "Presentation age threshold does not match the request"
    );
  }
}

export circuit assertValidSecretBirthCredentialAgePredicate(
  credential: SecretBirthCredential,
  presentation: SecretBirthCredentialPresentation,
  currentDay: Uint<32>,
  birthDateDays: Uint<32>,
  birthDateOpening: Bytes<32>
): [] {
  assert(
    presentation.disclosed.proveAgeOverThreshold,
    "Presentation must request the age-over-threshold predicate"
  );
  assert(
    birthDateCommitment(birthDateDays, birthDateOpening) == credential.claims.birthDateCommitment,
    "Birth-date witness does not match credential commitment"
  );
  assert(currentDay >= birthDateDays, "Current day must not precede the birth date witness");
  assert(
    currentDay - birthDateDays >= presentation.disclosed.ageThresholdYears * 365,
    "Age predicate does not satisfy the requested threshold"
  );
}
