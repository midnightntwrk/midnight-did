pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../credentials/src/credentials";
include "./birth-credential/model";

import VC<BirthCredentialClaims, BirthCredentialDisclosures, ExplicitHolderBinding>;

export type BirthCredential = Credential;
export type BirthCredentialPresentation = Presentation;
include "./birth-credential/protocol-model";

import IssuanceProtocol<
  BirthCredentialIssuanceOfferBody,
  BirthCredentialIssuanceRequestBody,
  BirthCredentialIssuanceResultBody
> prefix BirthCredentialIssuance_;

import PresentationProtocol<
  BirthCredentialVerificationRequestBody,
  BirthCredentialVerificationSubmissionBody,
  BirthCredentialVerificationResultBody
> prefix BirthCredentialVerification_;

export type BirthCredentialIssuanceOffer = BirthCredentialIssuance_OfferMessage;
export type BirthCredentialIssuanceRequest = BirthCredentialIssuance_RequestMessage;
export type BirthCredentialIssuanceResult = BirthCredentialIssuance_ResultMessage;
export type BirthCredentialVerificationRequest = BirthCredentialVerification_RequestMessage;
export type BirthCredentialVerificationSubmission = BirthCredentialVerification_SubmissionMessage;
export type BirthCredentialVerificationResult = BirthCredentialVerification_ResultMessage;
include "./birth-credential/helpers";
include "./birth-credential/validation";
