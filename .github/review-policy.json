{
  "version": 1,
  "routedReview": {
    "backend": "agent-review",
    "reviewers": ["patextreme"]
  },
  "commitIntegrity": {
    "acceptedSignatureTypes": ["GpgSignature", "SshSignature"],
    "dcoExemptBots": [
      {
        "authorLogin": "dependabot[bot]",
        "signatureSignerLogins": ["web-flow"]
      },
      {
        "authorLogin": "renovate[bot]",
        "signatureSignerLogins": ["web-flow"]
      }
    ]
  },
  "audit": {
    "requiredReviewerLogins": ["patextreme"],
    "structuredMarker": "agentflow-pr-review",
    "cleanVerdicts": ["approve", "approved", "clean", "pass"],
    "findingVerdicts": [
      "blocked",
      "changes",
      "changes-requested",
      "fail",
      "findings"
    ],
    "timeoutVerdicts": ["timeout"],
    "pageSize": 100,
    "maxPages": 10
  }
}
