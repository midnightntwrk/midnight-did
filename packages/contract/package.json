{
  "name": "@midnight-ntwrk/midnight-did-contract",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-did.git",
    "directory": "packages/contract"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "precompact": "pnpm --filter @midnight-ntwrk/midnight-did-jubjub-schnorr build",
    "prebuild": "pnpm run compact",
    "contract": "pnpm run compact",
    "build:prepared": "pnpm run build",
    "compact": "compact compile src/did.compact src/managed/did && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "pretest": "pnpm --filter @midnight-ntwrk/midnight-did-jubjub-schnorr build",
    "test": "vitest run",
    "pretest:ci": "pnpm --filter @midnight-ntwrk/midnight-did-jubjub-schnorr build",
    "test:ci": "vitest run",
    "test:compile": "pnpm run compact && vitest run",
    "prepack": "pnpm run build",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports",
    "build": "rm -rf dist && tsc -b tsconfig.build.json --force && mkdir -p dist && cp -Rf ./src/managed ./dist/ && cp ./src/did.compact ./dist",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"!src/managed/**\" && eslint src",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"!src/managed/**\" && eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "all": "pnpm run compact && pnpm run build && pnpm run test:ci"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.8"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "workspace:*"
  },
  "files": [
    "dist/**",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
