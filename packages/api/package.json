{
  "name": "@midnight-ntwrk/midnight-did-api",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-did.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run -c vitest.unit.config.ts --passWithNoTests",
    "test:ci": "vitest run -c vitest.unit.config.ts --passWithNoTests",
    "test-api": "vitest run -c vitest.api.config.ts",
    "coverage": "vitest run -c vitest.unit.config.ts --coverage",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" && eslint src examples",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" && eslint src examples --fix",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-did": "workspace:*",
    "@midnight-ntwrk/midnight-did-contract": "workspace:*",
    "@midnight-ntwrk/midnight-did-domain": "workspace:*",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "4.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@noble/curves": "^1.9.7",
    "effect": "3.22.4",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "7.8.2",
    "ws": "^8.18.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "workspace:*",
    "@vitest/coverage-v8": "4.1.11",
    "globals": "14.0.0",
    "long": "5.3.2",
    "protobufjs": "7.6.5"
  },
  "files": [
    "dist/**",
    "README.md",
    "examples/**",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
