# Repository-specific dev-loops@0.9.0 policy for midnight-did.
# Engineering rules and branch roles are authoritative in AGENT.md.
version: 1

strategy:
  default: github-first
inputSource:
  default: tracker

# `main` is GitHub's release/default branch and `develop` is the normal feature
# integration base. dev-loops 0.9.0 has no branch-role schema; AGENT.md owns it.
refinement:
  fanOut: 3
  mode: parallel
  # Zero disables Copilot rounds only. It is never a clean/acceptance signal:
  # `.github/review-policy.json` and the current-head feedback audit still require
  # routed Pat evidence before the human-approval checkpoint.
  maxCopilotRounds: 0
  stopOnLowSignal: false
  lowSignalRoundThreshold: 3
  lowSignalMaxComments: 2
  roles:
    - scope
    - coverage
    - correctness
    - security
    - midnight-did-surface
    - contract-artifacts

gates:
  draft:
    # Optional lenses are selected dynamically from changed paths to avoid
    # paying for overlapping reviewers on every PR.
    dynamicAngles: true
    additiveAngles: false
    angles:
      - scope
      - ci-guard
      - contract-surface
      - contract-artifacts
      - docs
      - link-check
      - config-drift
      - packaging-runtime
      - independent-review
    # These correctness and deterministic-spec lenses can never be removed by
    # dynamic selection.
    mandatoryAngles:
      - pr-description
      - correctness
      - coverage
      - security
      - midnight-did-surface
    blockCleanOnFindingSeverities:
      - must-fix
      - worth-fixing-now
    required: true
    requireCi: true
  preApproval:
    dynamicAngles: true
    additiveAngles: false
    angles:
      - contract-surface
      - contract-artifacts
      - ci-guard
      - docs
      - link-check
      - config-drift
      - packaging-runtime
      - independent-review
    mandatoryAngles:
      - pr-checklist-matrix
      - correctness
      - coverage
      - security
      - midnight-did-surface
    blockCleanOnFindingSeverities:
      - must-fix
      - worth-fixing-now
    required: true
    requireCi: true
  requireFanoutEvidence: true
  requireFanoutProvenance: true
  maxFanoutReviewers: 6
  postFindingsComments: true
  rejectForeignAngles: true

personas:
  security:
    persona: review
    prompt: >-
      Review for secret exposure, unsafe proof/key handling, authorization
      bypasses, dependency or supply-chain risk, and unsafe GitHub workflow
      behavior. Classify actionable findings as must-fix, worth-fixing-now, or
      defer and report concrete file and line references.
    defaultModel: null

  midnight-did-surface:
    persona: review
    prompt: >-
      Review the DID contract, domain, ledger mapping, API, package exports,
      specification, and downstream compatibility boundaries. Find drift,
      duplicated ownership, stale public behavior, or missing validation. Keep
      resolver services in midnight-did-resolver and VC behavior in the VC
      repository. Classify actionable findings as must-fix, worth-fixing-now,
      or defer and report concrete file and line references.
    defaultModel: null

  contract-artifacts:
    persona: review
    prompt: >-
      For Compact contract changes, compare generated circuit k, rows, prover
      key, verifier key, zkir, and bzkir sizes against the base branch. Flag k
      increases, unexpected artifact growth, stale generated artifacts, and
      missing docs updates. Classify findings and report file and line references.
    defaultModel: null

  independent-review:
    persona: review
    prompt: >-
      Independently review the current diff for correctness, security, stale
      documentation, API compatibility, test gaps, and regression risk. This is
      a local LLM lens, not Pat and not a substitute for the deterministic
      routed-review precondition in .github/review-policy.json. Classify
      actionable findings as must-fix, worth-fixing-now, or defer and report
      concrete file and line references, or report No findings.
    defaultModel: null

autonomy:
  stopAt:
    - pre-approval
    - merge
  humanMergeOnly: true

workflow:
  asyncStartMode: required
  requireDraftFirst: true
  requireRetrospective: true
  devModeDefault: false
