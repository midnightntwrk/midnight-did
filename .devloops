# Repository-specific dev-loops policy for midnight-did.
#
# This file must use the schema supported by the pinned dev-loops package.
# Repository engineering rules and command-level validation live in AGENT.md and
# the bundled midnight-identity skill.
version: 1

# The repository's current GitHub default branch is main. Base-branch policy is
# documented in AGENT.md because dev-loops 0.9.0 does not expose a repository
# base-branch field in this file schema.

refinement:
  fanOut: 3
  mode: parallel
  # This repository uses the configured local review fan-out; Copilot follow-up
  # is not an automatic gate. The post-PR dispatch wrapper also requests the
  # configured GitHub-routed reviewer; see AGENT.md.
  maxCopilotRounds: 0
  stopOnLowSignal: false
  lowSignalRoundThreshold: 3
  lowSignalMaxComments: 2
  roles:
    - scope
    - coverage
    - correctness
    - security
    - midnight-did-surface
    - contract-artifacts

# Draft and pre-approval gates use repository-specific DID/Compact lenses in
# addition to the standard lifecycle checks.
gates:
  draft:
    angles:
      - scope
      - correctness
      - coverage
      - ci-guard
      - contract-surface
      - contract-artifacts
      - docs
      - link-check
      - config-drift
      - packaging-runtime
      - midnight-did-surface
      - security
      - external-review
    mandatoryAngles:
      - pr-description
    required: true
    requireCi: true
  preApproval:
    angles:
      - correctness
      - coverage
      - contract-surface
      - contract-artifacts
      - ci-guard
      - docs
      - link-check
      - config-drift
      - packaging-runtime
      - security
      - midnight-did-surface
      - external-review
    mandatoryAngles:
      - pr-checklist-matrix
    required: true
    requireCi: true
  requireFanoutEvidence: true
  requireFanoutProvenance: false
  maxFanoutReviewers: 8
  postFindingsComments: true
  rejectForeignAngles: true

personas:
  security:
    persona: review
    prompt: >-
      Review for secret exposure, unsafe proof/key handling, authorization
      bypasses, dependency or supply-chain risk, and unsafe GitHub workflow
      behavior. Report concrete findings with file and line references.
    defaultModel: null

  midnight-did-surface:
    persona: review
    prompt: >-
      Review the DID contract, domain, ledger mapping, API, package exports,
      specification, and downstream compatibility boundaries. Find drift,
      duplicated ownership, stale public behavior, or missing validation. Keep
      resolver services in midnight-did-resolver and VC behavior in the VC
      repository. Report concrete findings with file and line references.
    defaultModel: null

  contract-artifacts:
    persona: review
    prompt: >-
      For Compact contract changes, compare generated circuit k, rows, prover
      key, verifier key, zkir, and bzkir sizes against the base branch. Flag k
      increases, unexpected artifact growth, stale generated artifacts, and
      missing docs updates. Report concrete findings with file and line
      references.
    defaultModel: null

  external-review:
    persona: review
    prompt: >-
      Independently review the PR for correctness, security, stale docs, API
      compatibility, tests, and regression risk. For Compact changes, check
      authorization binding, witness secrecy, managed artifact freshness,
      circuit k/size changes, and spec/docs drift. Do not modify files. Return
      only actionable findings with file/line references, or No findings.
    defaultModel: null

autonomy:
  # Allow the loop to complete draft review and feedback triage, but stop at
  # the pre-approval human checkpoint. Merge is always human-only.
  stopAt:
    - pre-approval
    - merge
  humanMergeOnly: true

workflow:
  requireDraftFirst: true
  requireRetrospective: true
  devModeDefault: false
