engine-strict=true
min-release-age=7
# The package scripts intentionally rely on prebuild/pretest/precompact hooks.
enable-pre-post-scripts=true
audit=false
fund=false

# agent-peer-review is published to GitHub Packages; use the caller's token.
@input-output-hk:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
